{
  "name": "muniyasamy-laundry-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "vite --config client/vite.config.js",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "vite --config client/vite.config.js",
    "dev:all": "concurrently -k \"npm:dev:server\" \"npm:dev\"",
    "build:client": "vite build --config client/vite.config.js",
    "vercel-build": "vite build --config client/vite.config.js && node scripts/prepare-vercel-output.js",
    "preview:client": "vite preview --config client/vite.config.js",
    "admin:create": "node server/src/create-admin.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^6.4.5"
  }
}
