PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/muniyasamy_laundry
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_32_CHARACTERS_OR_MORE
# For local same-origin development. In production, set the exact HTTPS origin assigned by your host or your own domain.
CLIENT_ORIGIN=http://localhost:4000
NODE_ENV=development
# Trust only the number of reverse-proxy hops in front of Express. Keep 0 locally.
TRUST_PROXY_HOPS=0
# Optional Vite development proxy target; otherwise Vite uses http://localhost:$PORT.
VITE_DEV_API_TARGET=
# Optional API origin only for an intentionally separate frontend deployment. Keep empty for same-origin hosting.
VITE_API_BASE_URL=
# Optional authenticated HTTPS webhooks. Leave blank until a real adapter endpoint is configured.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
